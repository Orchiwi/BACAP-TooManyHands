function bacaptmh:setup_stats_01
function bacaptmh:setup_stats_02
function bacaptmh:setup_stats_unverified

# The Gauntlet relay state (add 0 creates the entry without clobbering a run in progress)
scoreboard players add #chain bacaptmh_gaunt 0
scoreboard players add #timer bacaptmh_gaunt 0
scoreboard players add #dow bacaptmh_gaunt 0
scoreboard players add #dnether bacaptmh_gaunt 0
scoreboard players add #dend bacaptmh_gaunt 0

# Force every online player through the statistic-mirror seeding on the next medium tick,
# so a reload never lets a lifetime total read as a fresh event. f4_init is written so
# that this reseeding clears only short-lived windows - Barn Raising's block tally is
# created there with 'add 0' and survives.
scoreboard players reset * bacaptmh_init
# Weaponry / PvP block (F2). Start every statistic mirror of everyone already online
# from zero, so the first cycle after a reload cannot read a lifetime total as an event.
scoreboard players set #f2players bacaptmh_sys 0
execute as @a run function bacaptmh:detect/f2_init
scoreboard players set #n bacaptmh_n 0
scoreboard players set #need bacaptmh_n 0
scoreboard players set #ray bacaptmh_n 0
scoreboard players set #c bacaptmh_wave 0
scoreboard players set #t bacaptmh_wave -1
scoreboard players set #ponder bacaptmh_horn 0
scoreboard players set #sing bacaptmh_horn 0
scoreboard players set #seek bacaptmh_horn 0
scoreboard players set #feel bacaptmh_horn 0
scoreboard players set #admire bacaptmh_horn 0
scoreboard players set #call bacaptmh_horn 0
scoreboard players set #yearn bacaptmh_horn 0
scoreboard players set #dream bacaptmh_horn 0
scoreboard players set #sum bacaptmh_horn 0
scoreboard players set #timer bacaptmh_horn -1
# Seed every statistic mirror so the first comparison after a reload cannot
# read a lifetime total as a fresh event.
execute as @a run scoreboard players operation @s bacaptmh_jumpp = @s bacaptmh_jump
execute as @a run scoreboard players operation @s bacaptmh_sleepp = @s bacaptmh_sleep
execute as @a run scoreboard players operation @s bacaptmh_ghornp = @s bacaptmh_ghorn
execute as @a run scoreboard players operation @s bacaptmh_dropp = @s bacaptmh_drop
scoreboard players set #mp6players bacaptmh_mp6 0
scoreboard players reset * bacaptmh_gal
scoreboard players reset * bacaptmh_exit
scoreboard players reset * bacaptmh_ehurt
scoreboard players reset * bacaptmh_bb
# mp5: create the Nobody Dies Tonight streak counter WITHOUT clobbering a run in progress.
scoreboard players add #streak bacaptmh_ndt 0
# Batch mp4: short-lived windows start closed on every reload. The boat mirror and the ferry
# counter are deliberately NOT cleared - scores survive a reload, boat_one_cm cannot move while
# the server is down, and wiping the counter would throw away a voyage in progress.
scoreboard players reset * bacaptmh_kt
scoreboard players reset * bacaptmh_kh
scoreboard players reset * bacaptmh_kx
scoreboard players reset * bacaptmh_kz
scoreboard players reset * bacaptmh_tbf
# batch mp1 keeps no cross-reload state of its own: every mirror is a plain score that
# survives a /reload still matching its statistic, and every window is short-lived and
# self-ageing, so nothing here needs forcing back to a known value at load.
# mp2: reseed the two new statistic mirrors for everyone already online, so the first cycle
# after a reload cannot read a lifetime ride or a lifetime damage total as one window's worth.
execute as @a run scoreboard players add @s bacaptmh_naut 0
execute as @a run scoreboard players operation @s bacaptmh_nautp = @s bacaptmh_naut
execute as @a run scoreboard players add @s bacaptmh_dtk 0
execute as @a run scoreboard players operation @s bacaptmh_dtkp = @s bacaptmh_dtk
# Batch mp3: force every online player back through the mirror seeding in bacaptmh:seed on
# the next tick, so a reload can never let a lifetime statistic read as a fresh event.
scoreboard players reset * bacaptmh_b3i
# Trading Floor's shared pool. 'add 0' creates the row without clobbering a tally that
# is already part way to a thousand.
scoreboard players add #pool bacaptmh_tf 0
scoreboard players set #contrib bacaptmh_tf 0
# --- Too Many Hands batch M9 -------------------------------------------------------
# The Relay's three boss flags are global and long-lived: 'add 0' creates them at their
# current value, so a reload cannot clear a run that is already two thirds done.
scoreboard players add #wither bacaptmh_relay 0
scoreboard players add #warden bacaptmh_relay 0
scoreboard players add #dragon bacaptmh_relay 0
# Force every online player back through the M9 seeding on the next tick, so a reload can
# never let a lifetime statistic read as a fresh event. The seed clears only short-lived
# windows; Tunnel Vision's bore tally is created there with 'add 0' and survives.
scoreboard players reset * bacaptmh_m9i
# --- Too Many Hands batch mp12 ------------------------------------------------------
# Short-lived windows start closed after a reload, and the Golden Apple mirror is reseeded
# so the first cycle after a reload cannot read a lifetime total as a fresh event.
scoreboard players reset * bacaptmh_gt
scoreboard players reset * bacaptmh_glow
tag @a remove bacaptmh_anti
execute as @a run scoreboard players add @s bacaptmh_gapple 0
execute as @a run scoreboard players operation @s bacaptmh_gapple_m = @s bacaptmh_gapple
# mp11: reseed the statistic mirrors of everyone already online and drop every window
# and tag, so a reload can neither resume a half-finished run nor read a lifetime total.
execute as @a run scoreboard players operation @s bacaptmh_walkm = @s bacaptmh_walk
execute as @a run scoreboard players operation @s bacaptmh_sprm = @s bacaptmh_sprint
execute as @a run scoreboard players operation @s bacaptmh_hurtm = @s bacaptmh_hurt
execute as @a run scoreboard players operation @s bacaptmh_repm = @s bacaptmh_rep
scoreboard players reset * bacaptmh_sl
scoreboard players reset * bacaptmh_slb
scoreboard players reset * bacaptmh_esc
scoreboard players reset * bacaptmh_repn
tag @a remove bacaptmh_sl_rider
tag @a remove bacaptmh_esc_ward
tag @a remove bacaptmh_sb_self
# mp10: force the experience-bottle mirror to be retaken on every reload, so bottles
# thrown while the server was down can never read as one fresh donation. bacaptmh_gmc,
# gmb and gmw are created with 'add 0' in bacaptmh:seed, so a reload never wipes a
# sponsorship that is already in progress.
scoreboard players reset * bacaptmh_mp10
# Batch MP13 - force the private statistic mirrors through seeding again on the next tick,
# exactly as bacaptmh_init does for the F4 mirrors, so a /reload cannot let a lifetime total
# read as a fresh event. This also closes any in-flight Bunk Beds and sacrifice windows.
# bacaptmh_fed is NOT touched: the seed creates it with 'add 0'.
scoreboard players reset * bacaptmh_m13
# The dragon health sampler starts from a full-health baseline, so the first sample after a
# reload cannot look like a sudden drop.
scoreboard players set #g13hp bacaptmh_tmp 2000
scoreboard players set #g13prev bacaptmh_tmp 2000
# mp14: re-seed every statistic mirror for everyone already online, so the first cycle
# after a /reload cannot read a lifetime total as a fresh event.
execute as @a run scoreboard players add @s bacaptmh_pearl 0
execute as @a run scoreboard players operation @s bacaptmh_pearlp = @s bacaptmh_pearl
execute as @a store result score @s bacaptmh_xpn run experience query @s points
scoreboard players set @a bacaptmh_dcount 0
scoreboard players set @a bacaptmh_tw 0
# mpfill3: the Hospital Wing ward starts closed and empty.
scoreboard players set #hw_win bacaptmh_mf3 0
scoreboard players reset * bacaptmh_hw
scoreboard players set #bodycount bacaptmh_mpf2 0
scoreboard players set #cake bacaptmh_f1 0
scoreboard players reset * bacaptmh_f1cake
scoreboard players set #f4 bacaptmh_f4 0
scoreboard players reset * bacaptmh_bid
