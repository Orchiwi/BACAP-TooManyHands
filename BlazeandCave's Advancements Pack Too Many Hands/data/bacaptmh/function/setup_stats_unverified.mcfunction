# Statistics that look standard but that no installed pack uses, so this
# build cannot prove they exist. Isolated deliberately: if one of these
# names is wrong, only this file fails to load and only the advancements
# needing these statistics stop working. Everything else is unaffected.
scoreboard objectives add bacaptmh_boat minecraft.custom:minecraft.boat_one_cm
scoreboard objectives add bacaptmh_trade minecraft.custom:minecraft.traded_with_villager
scoreboard objectives add bacaptmh_walk minecraft.custom:minecraft.walk_one_cm
scoreboard objectives add bacaptmh_sprt minecraft.custom:minecraft.sprint_one_cm
scoreboard objectives add bacaptmh_sprint minecraft.custom:minecraft.sprint_one_cm
scoreboard objectives add bacaptmh_swim minecraft.custom:minecraft.swim_one_cm
