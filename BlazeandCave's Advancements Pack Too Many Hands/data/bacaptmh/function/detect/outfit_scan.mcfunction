# -- A9/A10: all four pieces trimmed with one material. The player stores worn armour
# under equipment.head/chest/legs/feet - the attested layout at this pack format, where
# Inventory only ever holds slots 0-35 - so that is the only path read.
execute if data entity @s equipment.head{components:{"minecraft:trim":{material:"minecraft:amethyst"}}} if data entity @s equipment.chest{components:{"minecraft:trim":{material:"minecraft:amethyst"}}} if data entity @s equipment.legs{components:{"minecraft:trim":{material:"minecraft:amethyst"}}} if data entity @s equipment.feet{components:{"minecraft:trim":{material:"minecraft:amethyst"}}} run scoreboard players set @s bacaptmh_dress_t 1
