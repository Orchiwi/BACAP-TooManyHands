# Runs as the nearest named animal in the namer's five-block ball. #cudone is the one-shot
# flag that ends the nearest-first walk started in custody_name: only one animal is ever
# stamped per naming, so a herd cannot end up carrying one player's id on every member.
scoreboard players operation @s bacaptmh_owner = #cuowner bacaptmh_sys
scoreboard players set #cudone bacaptmh_sys 1
