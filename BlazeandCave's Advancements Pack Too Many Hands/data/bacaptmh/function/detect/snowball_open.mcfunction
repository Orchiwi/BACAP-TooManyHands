# a fresh ten-second window: the timer is set here and nowhere else, so the window runs
# ten seconds from the first hit instead of being pushed forward by every later one
scoreboard players set @s bacaptmh_sb_timer 200
scoreboard players set @s bacaptmh_sb_count 0
scoreboard players set @s bacaptmh_sb_v1 0
scoreboard players set @s bacaptmh_sb_v2 0
scoreboard players set @s bacaptmh_sb_v3 0
